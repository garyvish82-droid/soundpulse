# ─── SoundCloud API ─────────────────────────────────────────────
# Register at: https://developers.soundcloud.com/
SOUNDCLOUD_CLIENT_ID=your_client_id_here
SOUNDCLOUD_CLIENT_SECRET=your_client_secret_here
SOUNDCLOUD_ACCESS_TOKEN=your_access_token_here   # obtained via OAuth

# ─── Supabase ───────────────────────────────────────────────────
# Get from: https://app.supabase.com → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here  # use service key, NOT anon key

# ─── MCP Server ─────────────────────────────────────────────────
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8080
MCP_SERVER_NAME=soundpulse

# ─── Demo API (FastAPI proxy) ───────────────────────────────────
DEMO_API_PORT=8000
ANTHROPIC_API_KEY=your_anthropic_api_key_here    # for the chat demo UI
CLAUDE_MODEL=claude-sonnet-4-6

# ─── AWS (for deployment) ───────────────────────────────────────
AWS_REGION=us-east-1
AWS_ECR_REPO=soundpulse
